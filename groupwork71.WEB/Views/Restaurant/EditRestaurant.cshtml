@model groupwork71.ViewModels.EditRestaurantViewModel

@{
    ViewData["Title"] = "Редактировать ресторан";
}

<div class="container mt-4">
    <h2>Редактировать ресторан</h2>
    <form asp-action="EditRestaurant" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Image" class="form-label"></label>
            <textarea asp-for="Image" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a asp-action="RestaurantList" class="btn btn-secondary">Отмена</a>
    </form>
</div>