 @model List<groupwork71.DAL.Models.Order>

@{
    ViewData["Title"] = "Index";
}

@if (Model.Count <= 0)
{
    <p>No orders yet</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>
                User
            </th>
            <th>
                Restaurant
            </th>
            <th>
                RecipientName
            </th>
            <th>
                PhoneNumber
            </th>
            <th>
                DeliveryAddress
            </th>
            <th>
                CreatedAt
            </th>
            <th>
                TotalPrice
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RestaurantId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RecipientName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DeliveryAddress)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalPrice)
                </td>
                <td>
                    <form asp-controller="Order" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="border-0 bg-transparent">Delete</button>
                    </form>|
                    <a asp-action="Details" class="text-decoration-none text-black" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}


