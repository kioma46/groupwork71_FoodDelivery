@model groupwork71.BLL.DTOs.CartDto

<div class="card">
    <div class="card-header fw-bold">Корзина</div>
    <div class="card-body">
        @if (!Model.Items.Any())
        {
            <p class="text-muted mb-0">Корзина пуста</p>
        }
        else
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var item in Model.Items)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <span>@item.DishName</span>
                            <button type="button" class="btn-close js-cart-remove"
                                    data-dish-id="@item.DishId" data-restaurant-id="@Model.RestaurantId"
                                    aria-label="Удалить"></button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary js-cart-decrease"
                                        data-dish-id="@item.DishId" data-restaurant-id="@Model.RestaurantId">−</button>
                                <span class="btn btn-light disabled">@item.Quantity</span>
                                <button type="button" class="btn btn-outline-secondary js-cart-add"
                                        data-dish-id="@item.DishId" data-restaurant-id="@Model.RestaurantId">+</button>
                            </div>
                            <span>@item.Total.ToString("0.00")</span>
                        </div>
                    </li>
                }
            </ul>
            <div class="d-flex justify-content-between fw-bold">
                <span>Итого:</span>
                <span>@Model.TotalPrice.ToString("0.00")</span>
            </div>
            <div>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                    Оформить заказ
                </button>
            </div>
        }
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Введите свои данные для заказа</h1>
            </div>
            <div class="modal-body">
                <form id="order-info-form" asp-controller="Order" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RestaurantId" value="@Model.RestaurantId" />
                    
                    <div class="mb-3">
                        <input class="form-control" name="RecipientName" id="form-recipient-name-input" type="text" placeholder="Ваше имя" required />
                    </div>
                    <div class="mb-3">
                        <input class="form-control" name="PhoneNumber" id="form-phone-number-input" type="text" placeholder="Номер телефона" required />
                    </div>
                    <div class="mb-3">
                        <input class="form-control" name="DeliveryAddress" id="form-delivery-address-input" type="text" placeholder="Адрес доставки" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                <button type="submit" form="order-info-form" class="btn btn-primary">Заказать</button>
            </div>
        </div>
    </div>
</div>